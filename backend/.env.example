PORT=8787
# Secrets stay here / in deployment secret storage, never in the Android binary.
TOMTOM_API_KEY=
GOOGLE_PLACES_API_KEY=

# OSM-backed geocoding/search. In production use a self-hosted Photon instance
# or a contracted hosted service. Do not depend on a public demo for production.
PHOTON_URL=

# Optional OSM-compatible corridor enrichment endpoint.
# Production should use a managed/self-hosted service with appropriate capacity/SLA.
# No public community endpoint is hard-coded into Scenic Path.
OSM_ENRICHMENT_URL=
