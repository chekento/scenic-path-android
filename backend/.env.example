PORT=8787

# Secrets stay here / in deployment secret storage, never in the Android binary.
# Required for the production Play release: vehicle-aware routing + exact Smart Stop reroutes.
TOMTOM_API_KEY=

# Required for the production Play release while Top Food is a shipped product promise.
# Used server-side only for verified ratings/review counts/place details.
GOOGLE_PLACES_API_KEY=

# OSM-backed geocoding/search. For production use a self-hosted Photon instance
# or a contracted hosted service with capacity/SLA. Public demo endpoints are development-only.
PHOTON_URL=

# Required for full production Scenic Categories / corridor enrichment.
# Use a managed/self-hosted OSM-compatible enrichment service with appropriate capacity/SLA.
# Do not point a Play release at a public community Overpass/demo endpoint.
OSM_ENRICHMENT_URL=

# Production readiness minimum:
# - TOMTOM_API_KEY set
# - GOOGLE_PLACES_API_KEY set
# - OSM_ENRICHMENT_URL set
# - PHOTON_URL strongly recommended (TomTom search remains a fallback)
